<Page x:Class="HeThongPOS.WPF.Views.POSView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1024"
      Title="Bán Hàng" Background="#f0f2f5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== BÊN TRÁI: Danh sách sản phẩm ==================== -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ô nhập mã vạch (Barcode Scanner USB) -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BarcodeTextBox" Grid.Column="0" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" Padding="10,0" FontSize="16" VerticalContentAlignment="Center"
                             BorderBrush="#d1d5db" BorderThickness="1"
                             Tag="🔍 Nhập Tên sản phẩm hoặc quét Mã vạch...">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchBarcodeCommand}"/>
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TextBox}}" Foreground="#9ca3af" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Content="Quét" Command="{Binding SearchBarcodeCommand}"
                            Style="{StaticResource PrimaryButton}" Width="80" Height="40" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Thông báo lỗi -->
            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red"
                       TextWrapping="Wrap" Margin="0,0,0,5"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Danh sách sản phẩm dạng lưới (WrapPanel) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DanhSachSanPham}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ProductCard -->
                            <Border Width="150" Height="130" Background="White" CornerRadius="6"
                                    Margin="5" Padding="10" Cursor="Hand"
                                    BorderBrush="#e5e7eb" BorderThickness="1">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ThemSanPhamCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#1a73e8"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center">
                                    <Image Source="{Binding HinhAnhUrl, Converter={StaticResource ImageUrlConverter}}" 
                                           Height="60" Width="60" Stretch="UniformToFill" Margin="0,0,0,5"
                                           HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TenSanPham}" FontWeight="SemiBold"
                                               FontSize="13" TextWrapping="Wrap" MaxHeight="40"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MaVach}" Foreground="#6b7280"
                                               FontSize="11" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding GiaBan, Converter={StaticResource CurrencyConverter}}"
                                               Foreground="#1a73e8" FontWeight="Bold" FontSize="14"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Foreground="#6b7280" FontSize="11" Margin="0,2,0,0">
                                        <Run Text="Tồn: "/><Run Text="{Binding TonKho, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ==================== BÊN PHẢI: Giỏ hàng ==================== -->
        <Border Grid.Column="1" Background="White" Margin="0,10,10,10" CornerRadius="6" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header giỏ hàng -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Giỏ hàng" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                    <Button Content="Xóa hết" Command="{Binding XoaHetCommand}"
                            HorizontalAlignment="Right" Foreground="Red" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" FontSize="13"/>
                </Grid>

                <!-- Danh sách item trong giỏ -->
                <ListView Grid.Row="1" ItemsSource="{Binding GioHang}" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#f3f4f6" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tên SP -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TenSanPham}" FontWeight="SemiBold"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DonGia, Converter={StaticResource CurrencyConverter}}"
                                                   Foreground="#6b7280" FontSize="11"/>
                                    </StackPanel>

                                    <!-- Nút +/- số lượng -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="5,0">
                                        <Button Content="-" Width="28" Height="28" FontSize="14"
                                                Background="#f3f4f6" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding SoLuong}" Width="30"
                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" FontSize="14"/>
                                        <Button Content="+" Width="28" Height="28" FontSize="14"
                                                Background="#f3f4f6" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <!-- Thành tiền + nút xóa -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ThanhTien, Converter={StaticResource CurrencyConverter}}"
                                                   FontWeight="Bold" FontSize="13" TextAlignment="Right"/>
                                        <Button Content="Xóa" FontSize="11" Foreground="Red"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" HorizontalAlignment="Right"
                                                Command="{Binding DataContext.XoaItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Bảng tổng tiền -->
                <StackPanel Grid.Row="2" Margin="0,10,0,10">
                    <Separator Margin="0,0,0,8"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="Tổng tiền hàng:" Foreground="#374151"/>
                        <TextBlock Text="{Binding TongTienHang, Converter={StaticResource CurrencyConverter}}"
                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <TextBlock Text="Thuế VAT (8%):" Foreground="#374151"/>
                        <TextBlock Text="{Binding ThueVAT, Converter={StaticResource CurrencyConverter}}"
                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Separator Margin="0,8,0,4"/>
                    <Grid Margin="0,2">
                        <TextBlock Text="TỔNG THANH TOÁN:" FontWeight="Bold" FontSize="16"
                                   Foreground="#111827"/>
                        <TextBlock Text="{Binding TongThanhToan, Converter={StaticResource CurrencyConverter}}"
                                   HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                                   Foreground="#1a73e8"/>
                    </Grid>
                </StackPanel>

                <!-- Nút thanh toán -->
                <Button Grid.Row="3" Content="Thanh Toán" Command="{Binding OpenPaymentCommand}"
                        Style="{StaticResource PrimaryButton}" Height="50" FontSize="18" Margin="0,5,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
