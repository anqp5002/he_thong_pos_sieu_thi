<UserControl x:Class="HeThongPOS.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Cài Đặt Hệ Thống" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}"/>
                <TextBlock Text="Quản lý tài khoản cá nhân và thông số thiết bị POS" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
            </StackPanel>
        </Grid>

        <!-- Main Configuration Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Account and Password -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <!-- User Profile Info Card -->
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Thông Tin Tài Khoản" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tên đăng nhập" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Username, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" Width="240" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Họ và tên" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding FullName, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" Width="240" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid>
                            <TextBlock Text="Chức vụ" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding RoleName, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" Width="240" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Change Password Form Card -->
                <Border Style="{StaticResource CardBorder}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Đổi Mật Khẩu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,15"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Mật khẩu hiện tại" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="TxtOldPassword" Height="36"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Mật khẩu mới (tối thiểu 6 ký tự)" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="TxtNewPassword" Height="36"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Xác nhận mật khẩu mới" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="TxtConfirmPassword" Height="36"/>
                        </StackPanel>

                        <Button Content="Đổi Mật Khẩu" Click="BtnChangePassword_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="150"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT COLUMN: System configurations -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                <Border Style="{StaticResource CardBorder}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Cấu Hình Hệ Thống (Mô phỏng)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,15"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Tên cửa hàng" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StoreName}" Height="36"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Địa chỉ cửa hàng" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StoreAddress}" Height="36"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Mã số thuế" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TaxCode}" Height="36"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Mã thiết bị POS" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TerminalId}" Height="36"/>
                        </StackPanel>

                        <Button Content="Lưu Cấu Hình" Click="BtnSaveConfig_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="150"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
