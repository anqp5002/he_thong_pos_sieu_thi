<UserControl x:Class="HeThongPOS.WPF.Views.ShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="Quản Lý Ca Làm Việc" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}"/>
                <TextBlock Text="Khai báo số dư đầu ca và kết toán quỹ tiền mặt bàn giao ca cuối ca" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
            
            <!-- STATE 1: OPEN SHIFT FORM (Shown when IsShiftOpen is False) -->
            <Border Padding="25">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShiftOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <StackPanel>
                    <!-- Icon & Title -->
                    <Border Background="{StaticResource PrimaryLightColor}" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="🔑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MỞ CA LÀM VIỆC" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Vui lòng nhập quỹ tiền mặt đầu ca để bắt đầu làm việc" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Info fields -->
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Thu ngân:" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Thời gian:" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="Hiện tại" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderLightColor}" Margin="0,0,0,20"/>

                    <!-- Input Opening Fund -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Số dư đầu ca (Quỹ tiền mặt đầu ca)" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding OpeningFundInput, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Height="38" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Start Button -->
                    <Button Command="{Binding OpenShiftCommand}" Content="Bắt Đầu Ca Làm Việc" Style="{StaticResource PrimaryButton}" Height="40" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- STATE 2: CLOSE SHIFT FORM (Shown when IsShiftOpen is True) -->
            <Border Padding="25">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShiftOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- Icon & Title -->
                    <Border Background="#FEE2E2" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="🕒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="KẾT CA LÀM VIỆC" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Đối chiếu doanh thu hệ thống và bàn giao quỹ tiền mặt" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Details grid -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Thu ngân:" Foreground="{StaticResource TextSecondaryColor}"/>
                        <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Thời gian mở ca:" Foreground="{StaticResource TextSecondaryColor}"/>
                        <TextBlock Text="{Binding StartTimeDisplay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Tiền mặt đầu ca:" Foreground="{StaticResource TextSecondaryColor}"/>
                        <TextBlock Text="{Binding OpeningFund, StringFormat={}{0:N0}đ}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Doanh thu trong ca:" Foreground="{StaticResource TextSecondaryColor}"/>
                        <TextBlock Text="{Binding SystemSales, StringFormat={}{0:N0}đ}" FontWeight="SemiBold" Foreground="{StaticResource SuccessColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Tổng tiền mặt dự kiến:" Foreground="{StaticResource TextSecondaryColor}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ExpectedCash, StringFormat={}{0:N0}đ}" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderLightColor}" Margin="0,0,0,15"/>

                    <!-- Inputs -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Tiền mặt cuối ca thực tế đếm được" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ActualCashInput, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Height="36" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Ghi chú bàn giao (lý do chênh lệch nếu có)" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5" FontSize="11"/>
                        <TextBox Text="{Binding NoteInput, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="12" Tag="Nhập ghi chú..."/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Command="{Binding CloseShiftCommand}" Content="Đóng Ca Làm Việc (Kết Ca)" Style="{StaticResource PrimaryButton}" Background="#EF4444" Height="40" FontSize="13"/>
                </StackPanel>
            </Border>
            
        </Grid>
    </Grid>
</UserControl>
