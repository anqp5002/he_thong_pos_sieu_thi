<Page x:Class="HeThongPOS.WPF.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1024"
      Title="Dashboard" Background="#f0f2f5">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <!-- ==================== HÀNG 1: 4 thẻ thống kê ==================== -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Thẻ Doanh thu hôm nay -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Doanh thu hôm nay" FontSize="13" Foreground="#6b7280"/>
                        <TextBlock Text="{Binding DoanhThuHomNay, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#1a73e8" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Thẻ Số đơn hôm nay -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Số đơn hôm nay" FontSize="13" Foreground="#6b7280"/>
                        <TextBlock Text="{Binding SoDonHomNay}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Thẻ Doanh thu tháng -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Doanh thu tháng này" FontSize="13" Foreground="#6b7280"/>
                        <TextBlock Text="{Binding DoanhThuThangNay, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#7c3aed" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Thẻ Tổng sản phẩm -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Tổng sản phẩm" FontSize="13" Foreground="#6b7280"/>
                        <TextBlock Text="{Binding TongSanPham}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#ea580c" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ==================== HÀNG 2: Biểu đồ doanh thu ==================== -->
            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Biểu đồ doanh thu 7 ngày gần nhất" FontSize="16" FontWeight="Bold" 
                               Foreground="#111827" Margin="0,0,0,15"/>
                    <lvc:CartesianChart Series="{Binding SalesSeries}" 
                                        XAxes="{Binding XAxes}" 
                                        YAxes="{Binding YAxes}"
                                        Height="300"/>
                </StackPanel>
            </Border>

            <!-- ==================== HÀNG 3: Top sản phẩm bán chạy ==================== -->
            <Border Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Top 10 sản phẩm bán chạy" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                        <Button Content="Tải lại" Command="{Binding LoadDataCommand}" 
                                HorizontalAlignment="Right" Background="#f3f4f6" BorderThickness="0" 
                                Padding="15,5" Cursor="Hand" FontSize="13"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" 
                              BorderThickness="1" BorderBrush="#e5e7eb"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="40" ColumnHeaderHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="50"
                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, 
                                                Converter={StaticResource RowIndexConverter}}"/>
                            <DataGridTextColumn Header="Tên sản phẩm" Width="*" Binding="{Binding TenSanPham}"/>
                            <DataGridTextColumn Header="Tổng SL bán" Width="120" Binding="{Binding TongSoLuong}"/>
                            <DataGridTextColumn Header="Tổng doanh thu" Width="150" 
                                                Binding="{Binding TongDoanhThu, Converter={StaticResource CurrencyConverter}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
