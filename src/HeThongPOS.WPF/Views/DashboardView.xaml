<Page x:Class="HeThongPOS.WPF.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1024"
      Title="Dashboard" Background="#f0f2f5">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <!-- ==================== HÀNG 1: 4 thẻ thống kê ==================== -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Thẻ Doanh thu hôm nay -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Doanh thu hôm nay" FontSize="13" Foreground="#6b7280"/>
                        <TextBlock Text="{Binding DoanhThuHomNay, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#1a73e8" Margin="0,8,0,0"/>
                        <TextBlock FontSize="12" Foreground="#6b7280" Margin="0,5,0,0">
                            <Run Text="💵 Tiền mặt: "/><Run Text="{Binding TienMatHomNay, Converter={StaticResource CurrencyConverter}}"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#6b7280" Margin="0,2,0,0">
                            <Run Text="💳 Chuyển khoản: "/><Run Text="{Binding ChuyenKhoanHomNay, Converter={StaticResource CurrencyConverter}}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Thẻ Số đơn hôm nay -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Số đơn hôm nay" FontSize="13" Foreground="#6b7280"/>
                        <TextBlock Text="{Binding SoDonHomNay}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,8,0,0"/>
                        <TextBlock FontSize="12" Foreground="#6b7280" Margin="0,5,0,0">
                            <Run Text="✅ Thành công: "/><Run Text="{Binding DonThanhCongHomNay}"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#6b7280" Margin="0,2,0,0">
                            <Run Text="❌ Thất bại/Hủy: "/><Run Text="{Binding DonThatBaiHomNay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Thẻ Tiền thuế (VAT) -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Tiền thuế (VAT) hôm nay" FontSize="13" Foreground="#6b7280"/>
                        <TextBlock Text="{Binding ThueVATHomNay, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#ea580c" Margin="0,8,0,0"/>
                        <TextBlock FontSize="12" Foreground="#6b7280" Margin="0,5,0,0">
                            <Run Text="Mức thuế suất chung: 8%"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="Transparent" Margin="0,2,0,0" Text="Khoảng trống cân bằng thẻ"/>
                    </StackPanel>
                </Border>

                <!-- Thẻ Doanh thu tháng -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Doanh thu tháng này" FontSize="13" Foreground="#6b7280"/>
                        <TextBlock Text="{Binding DoanhThuThangNay, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#7c3aed" Margin="0,8,0,0"/>
                        <TextBlock FontSize="12" Foreground="#6b7280" Margin="0,5,0,0">
                            <Run Text="📦 Đang kinh doanh: "/><Run Text="{Binding TongSanPham}"/><Run Text=" SP"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="Transparent" Margin="0,2,0,0" Text="Khoảng trống cân bằng thẻ"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ==================== HÀNG 2: Biểu đồ doanh thu ==================== -->
            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Biểu đồ doanh thu 7 ngày gần nhất" FontSize="16" FontWeight="Bold" 
                               Foreground="#111827" Margin="0,0,0,15"/>
                    <lvc:CartesianChart Series="{Binding SalesSeries}" 
                                        XAxes="{Binding XAxes}" 
                                        YAxes="{Binding YAxes}"
                                        Height="300"/>
                </StackPanel>
            </Border>

            <!-- ==================== HÀNG 3: Báo Cáo & Top Sản Phẩm ==================== -->
            <Border Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Chi Tiết Báo Cáo" FontSize="16" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                        
                        <Button Grid.Column="1" Content="📥 Xuất Excel Báo Cáo Ca" Command="{Binding ExportToExcelCommand}" 
                                Margin="0,0,10,0" Background="#10b981" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                                Padding="15,5" Cursor="Hand" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        
                        <Button Grid.Column="2" Content="🔄 Tải lại" Command="{Binding LoadDataCommand}" 
                                Background="#f3f4f6" BorderThickness="0" 
                                Padding="15,5" Cursor="Hand" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    
                    <TabControl Background="Transparent" BorderThickness="0">
                        <!-- Tab 1: Báo Cáo Ca Làm Việc -->
                        <TabItem Header="Báo Cáo Ca Hôm Nay" FontSize="14" FontWeight="SemiBold">
                            <DataGrid ItemsSource="{Binding CaLamViecs}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" 
                                      BorderThickness="1" BorderBrush="#e5e7eb"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeight="40" ColumnHeaderHeight="40" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nhân viên" Width="150" Binding="{Binding TenNhanVien}"/>
                                    <DataGridTextColumn Header="Mở ca" Width="70" Binding="{Binding ThoiGianBatDau}"/>
                                    <DataGridTextColumn Header="Đóng ca" Width="70" Binding="{Binding ThoiGianKetThuc}"/>
                                    <DataGridTextColumn Header="Tiền mở ca" Width="120" Binding="{Binding SoDuDauCa, Converter={StaticResource CurrencyConverter}}"/>
                                    <DataGridTextColumn Header="Doanh thu ca" Width="120" Binding="{Binding TongDoanhThu, Converter={StaticResource CurrencyConverter}}"/>
                                    <DataGridTextColumn Header="Thực thu" Width="120" Binding="{Binding SoDuCuoiCaThucTe, Converter={StaticResource CurrencyConverter}}"/>
                                    <DataGridTemplateColumn Header="Độ lệch (Thiếu/Dư)" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ChenhLech, Converter={StaticResource CurrencyConverter}}" 
                                                           FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6b7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChenhLech, Converter={StaticResource LessThanZeroConverter}}" Value="True">
                                                                    <Setter Property="Foreground" Value="#ef4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ChenhLech, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                                    <Setter Property="Foreground" Value="#10b981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Trạng thái" Width="*" Binding="{Binding TrangThai}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        
                        <!-- Tab 2: Top Sản Phẩm Bán Chạy -->
                        <TabItem Header="Top Sản Phẩm Bán Chạy" FontSize="14" FontWeight="SemiBold">
                            <DataGrid ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" 
                                      BorderThickness="1" BorderBrush="#e5e7eb"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeight="40" ColumnHeaderHeight="40" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Width="50"
                                                        Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, 
                                                        Converter={StaticResource RowIndexConverter}}"/>
                                    <DataGridTextColumn Header="Tên sản phẩm" Width="*" Binding="{Binding TenSanPham}"/>
                                    <DataGridTextColumn Header="Tổng SL bán" Width="120" Binding="{Binding TongSoLuong}"/>
                                    <DataGridTextColumn Header="Tổng doanh thu" Width="150" 
                                                        Binding="{Binding TongDoanhThu, Converter={StaticResource CurrencyConverter}}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
