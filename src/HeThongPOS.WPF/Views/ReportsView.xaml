<UserControl x:Class="HeThongPOS.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: DAILY SALES REPORT [R21] -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,15,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <TextBlock Text="DAILY SALES REPORT [R21]" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,2"/>
                    <TextBlock Text="Sales Date: Hôm nay" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,15"/>

                    <!-- Audit Values -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Gross Sale" Foreground="{StaticResource TextSecondaryColor}" FontSize="12"/>
                        <TextBlock Text="{Binding GrossSales, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="= Net Sales" Foreground="{StaticResource TextSecondaryColor}" FontSize="12"/>
                        <TextBlock Text="{Binding NetSales, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderLightColor}" Margin="0,0,0,12"/>

                    <!-- Cash Audit -->
                    <TextBlock Text="Cash Audit" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                    
                    <Grid Margin="10,0,0,6">
                        <TextBlock Text="Net Sales" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding NetSales, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,6">
                        <TextBlock Text="= Cash Sales" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding CashSales, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,6">
                        <TextBlock Text="+ Opening Fund" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding OpeningFund, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,6">
                        <TextBlock Text="+ Cash Received" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding CashReceived, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,6">
                        <TextBlock Text="- Till Out" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding TillOut, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,12">
                        <TextBlock Text="= Cash Over(-)/Short(+)" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding CashDifference, StringFormat={}{0:N0}đ}" Foreground="#10B981" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderLightColor}" Margin="0,0,0,12"/>

                    <!-- Audit Trail -->
                    <TextBlock Text="Audit Trail" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                    
                    <Grid Margin="10,0,0,6">
                        <TextBlock Text="Cashier Void" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding CashierVoidCount}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,6">
                        <TextBlock Text="Refund (By Item)" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding RefundItemCount}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,12">
                        <TextBlock Text="Refund (By Amount)" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding RefundAmount, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderLightColor}" Margin="0,0,0,12"/>

                    <!-- Open Bill -->
                    <TextBlock Text="Open Bill" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                    
                    <Grid Margin="10,0,0,6">
                        <TextBlock Text="Count" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding OpenBillCount}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="10,0,0,12">
                        <TextBlock Text="Amount Disp" Foreground="{StaticResource TextSecondaryColor}" FontSize="11.5"/>
                        <TextBlock Text="{Binding OpenBillAmount, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderLightColor}" Margin="0,0,0,15"/>

                    <!-- Total -->
                    <Grid>
                        <TextBlock Text="Total Net Sales" Foreground="{StaticResource TextSecondaryColor}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NetSales, StringFormat={}{0:N0}đ}" Foreground="{StaticResource TextPrimaryColor}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="Grand Total" Foreground="{StaticResource TextSecondaryColor}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N0}đ}" Foreground="{StaticResource PrimaryColor}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- CENTER MAIN REPORTS VIEW -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title & Top Action Buttons -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reports" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}"/>
                    <TextBlock Text="Tổng hợp doanh thu" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Today Data" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Padding="12,6"/>
                    <Button Content="History Data" Style="{StaticResource OutlinedButton}" Padding="12,6"/>
                </StackPanel>
            </Grid>

            <!-- 4 Summary Cards -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                <!-- Revenue Today -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Doanh thu" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                        <TextBlock Text="{Binding RevenueToday, StringFormat={}{0:N0}đ}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="0,5,0,0"/>
                        <TextBlock Text="Hôm nay" FontSize="9.5" Foreground="{StaticResource TextSecondaryColor}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Transactions count -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Giao dịch" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                        <TextBlock Text="{Binding TransactionCountToday}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,5,0,0"/>
                        <TextBlock Text="Đơn hàng đã hoàn thành" FontSize="9.5" Foreground="{StaticResource TextSecondaryColor}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Average bill -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Trung bình" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                        <TextBlock Text="{Binding AverageTicketToday, StringFormat={}{0:N0}đ}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,5,0,0"/>
                        <TextBlock Text="Giá trị / Đơn hàng" FontSize="9.5" Foreground="{StaticResource TextSecondaryColor}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Top selling product -->
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TopProductCountToday}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerColor}"/>
                            <TextBlock Text=" đơn" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TopProductToday}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerColor}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Sản phẩm bán chạy nhất" FontSize="9.5" Foreground="{StaticResource TextSecondaryColor}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Report Types Matrix Selection -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="LOẠI BÁO CÁO" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>
                <UniformGrid Columns="4" Rows="2">
                    <Button Content="Daily Sales Report" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Height="36"/>
                    <Button Content="Sales Mix Report" Style="{StaticResource OutlinedButton}" Margin="0,0,8,8" Height="36"/>
                    <Button Content="Discount Detail Report" Style="{StaticResource OutlinedButton}" Margin="0,0,8,8" Height="36"/>
                    <Button Content="Payment Detail Report" Style="{StaticResource OutlinedButton}" Margin="0,0,0,8" Height="36"/>
                    <Button Content="Cashier Report" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0" Height="36"/>
                    <Button Content="Hour Sales Report" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0" Height="36"/>
                    <Button Content="Top 25 Sales" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0" Height="36"/>
                    <Button Content="Top 25 Quantity" Style="{StaticResource OutlinedButton}" Height="36"/>
                </UniformGrid>
            </StackPanel>

            <!-- Revenue Trend (7 Days) -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Xu hướng doanh thu 7 ngày" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,10"/>

                    <!-- Vector Canvas Chart -->
                    <Canvas Grid.Row="1" x:Name="ChartCanvas" Height="160" Background="Transparent" VerticalAlignment="Center"/>

                    <!-- X-Axis Labels -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ChartLabels}" Margin="0,5,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Bottom Actions -->
            <Grid Grid.Row="4">
                <Button Command="{Binding PrintCommand}" Style="{StaticResource OutlinedButton}" Padding="20,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨 " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="In báo cáo" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding ExportDataCommand}" Style="{StaticResource OutlinedButton}" Content="Xuất báo cáo" Padding="20,10" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Về bán hàng" Padding="25,10" Margin="0,0,10,0"/>
                    <!-- Pinkish red Close Shift -->
                    <Button Style="{StaticResource PrimaryButton}" Background="#EF4444" Content="Kết ca" Padding="25,10"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
