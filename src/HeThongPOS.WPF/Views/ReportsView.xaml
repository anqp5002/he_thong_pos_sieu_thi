<UserControl x:Class="HeThongPOS.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Báo Cáo &amp; Thống Kê" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
            
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="0,0,20,0"/>
                
                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="120" Margin="0,0,20,0"/>

                <Button Content="Lọc Dữ Liệu" Command="{Binding LoadDataCommand}" Width="100" Margin="0,0,10,0" Background="#3498db" Foreground="White" BorderThickness="0" Padding="5"/>
                <Button Content="Xuất Excel" Command="{Binding ExportDataCommand}" Width="100" Background="#2ecc71" Foreground="White" BorderThickness="0" Padding="5"/>
            </WrapPanel>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Tổng Doanh Thu" FontSize="14" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} ₫}" FontSize="28" FontWeight="Bold" Foreground="#2ecc71" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Tổng Số Đơn" FontSize="14" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding TotalOrders, StringFormat={}{0:N0}}" FontSize="28" FontWeight="Bold" Foreground="#3498db" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="AOV (Gtrị Đơn TB)" FontSize="14" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding AOV, StringFormat={}{0:N0} ₫}" FontSize="28" FontWeight="Bold" Foreground="#9b59b6" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Charts and Tables -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- Chart -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Biểu Đồ Doanh Thu" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding RevenueSeries}" 
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        TooltipPosition="Right"
                                        Margin="10"/>
                </Grid>
            </Border>

            <!-- Top Products -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Sản Phẩm Bán Chạy" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên SP" Binding="{Binding TenSanPham}" Width="*"/>
                            <DataGridTextColumn Header="Đã Bán" Binding="{Binding SoLuongBan}" Width="60"/>
                            <DataGridTextColumn Header="Doanh Thu" Binding="{Binding DoanhThu, StringFormat={}{0:N0}}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2ecc71"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
