<Window x:Class="HeThongPOS.WPF.Controls.ProductFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="520" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã vạch:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Product.MaVach, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên SP:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Product.TenSanPham, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Danh mục:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Categories}" DisplayMemberPath="TenDanhMuc" SelectedValuePath="Id" SelectedValue="{Binding Product.DanhMucId}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Giá bán:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Product.GiaBan, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Tồn kho:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Product.TonKho, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Đơn vị tính:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Product.DonViTinh, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Trạng thái:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding Product.TrangThai}" Margin="0,0,0,10" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Link ảnh:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Product.HinhAnhUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Lưu" Command="{Binding SaveCommand}" Width="80" Margin="0,0,10,0" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Hủy" Command="{Binding CancelCommand}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
