<Window x:Class="HeThongPOS.WPF.Controls.CustomerFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Họ Tên:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="5"/>

        <TextBlock Grid.Row="2" Text="Số Điện Thoại:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="5"/>

        <TextBlock Grid.Row="4" Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="5"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Lưu" Command="{Binding SaveCommand}" Width="80" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Hủy" Command="{Binding CancelCommand}" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
