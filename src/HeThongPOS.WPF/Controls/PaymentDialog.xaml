<Window x:Class="HeThongPOS.WPF.Controls.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:HeThongPOS.WPF.Controls"
        mc:Ignorable="d" 
        Title="Thanh Toán" Height="650" Width="800" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f0f2f5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="THANH TOÁN ĐƠN HÀNG" FontSize="20" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Thông tin đơn & Khách hàng -->
            <StackPanel Grid.Column="0">
                <Border Background="White" CornerRadius="6" Padding="15" BorderBrush="#e5e7eb" BorderThickness="1" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Tổng tiền thanh toán" FontSize="14" Foreground="#6b7280" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TongThanhToan, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="32" FontWeight="Bold" Foreground="#1a73e8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Chọn Khách Hàng -->
                <local:CustomerSelect />
            </StackPanel>

            <!-- Cột phải: Phương thức TT & Khách đưa -->
            <StackPanel Grid.Column="2">
                <Border Background="White" CornerRadius="6" Padding="15" BorderBrush="#e5e7eb" BorderThickness="1" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Phương thức thanh toán" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#374151"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <RadioButton Grid.Column="0" Content="Tiền mặt" GroupName="PaymentMethod" 
                                         IsChecked="{Binding PhuongThucThanhToan, Converter={StaticResource StringToBoolConverter}, ConverterParameter=CASH}"
                                         Style="{StaticResource ToggleRadioButton}"/>
                                         
                            <RadioButton Grid.Column="2" Content="Chuyển khoản / Thẻ" GroupName="PaymentMethod" 
                                         IsChecked="{Binding PhuongThucThanhToan, Converter={StaticResource StringToBoolConverter}, ConverterParameter=CARD}"
                                         Style="{StaticResource ToggleRadioButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Vùng nhập tiền (chỉ hiện nếu là tiền mặt) -->
                <local:CashPaymentControl Visibility="{Binding PhuongThucThanhToan, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=CASH}"/>
            </StackPanel>
        </Grid>

        <!-- Nút hành động -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Hủy (Esc)" Command="{Binding CancelCommand}"
                    Height="50" FontSize="16" Background="White" BorderBrush="#d1d5db" BorderThickness="1" Foreground="#374151" Cursor="Hand"/>
            <Button Grid.Column="2" Content="HOÀN TẤT THANH TOÁN" Command="{Binding CheckoutCommand}"
                    Style="{StaticResource PrimaryButton}" Height="50" FontSize="16" IsEnabled="{Binding CanCheckout}"/>
        </Grid>
    </Grid>
</Window>
