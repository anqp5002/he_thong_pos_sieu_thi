<Window x:Class="HeThongPOS.WPF.Controls.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f0f2f5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="THANH TOÁN ĐƠN HÀNG" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Tổng thanh toán:" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentOrder.TongThanhToan, StringFormat={}{0:N0} đ}" FontSize="24" FontWeight="Bold" Foreground="#e53935" HorizontalAlignment="Right"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Khách thanh toán (VNĐ):" Margin="0,0,0,5" Foreground="#757575"/>
            <TextBox Text="{Binding AmountProvided, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="5" />
        </StackPanel>

        <Grid Grid.Row="3">
            <TextBlock Text="Tiền thối lại:" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ChangeAmount, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        
        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Hủy bỏ" Command="{Binding CancelPaymentCommand}" Background="#eeeeee" Height="40" FontSize="14"/>
            <Button Grid.Column="2" Content="Hoàn tất thanh toán" Command="{Binding ProcessPaymentCommand}" Background="#1a73e8" Foreground="White" Height="40" FontSize="14"/>
        </Grid>
    </Grid>
</Window>
