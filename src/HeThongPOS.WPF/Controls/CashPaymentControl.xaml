<UserControl x:Class="HeThongPOS.WPF.Controls.CashPaymentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="350">
    
    <Border Background="White" CornerRadius="6" Padding="15" BorderBrush="#e5e7eb" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Thông tin thanh toán" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#374151"/>

            <!-- Khách đưa -->
            <TextBlock Text="Khách đưa:" FontSize="13" Foreground="#6b7280" Margin="0,0,0,5"/>
            <TextBox Text="{Binding KhachDua, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" 
                     Height="40" Padding="10,0" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center"
                     BorderBrush="#d1d5db" BorderThickness="1" Foreground="#111827"/>

            <!-- Nút gợi ý tiền nhanh -->
            <WrapPanel Margin="0,10,0,0">
                <Button Content="Vừa đủ" Command="{Binding SetQuickAmountCommand}" CommandParameter="EXACT"
                        Margin="0,0,5,5" Width="75" Height="30" Background="#f3f4f6" BorderThickness="0" Cursor="Hand"/>
                <Button Content="50,000" Command="{Binding SetQuickAmountCommand}" CommandParameter="50000"
                        Margin="0,0,5,5" Width="75" Height="30" Background="#f3f4f6" BorderThickness="0" Cursor="Hand"/>
                <Button Content="100,000" Command="{Binding SetQuickAmountCommand}" CommandParameter="100000"
                        Margin="0,0,5,5" Width="75" Height="30" Background="#f3f4f6" BorderThickness="0" Cursor="Hand"/>
                <Button Content="200,000" Command="{Binding SetQuickAmountCommand}" CommandParameter="200000"
                        Margin="0,0,5,5" Width="75" Height="30" Background="#f3f4f6" BorderThickness="0" Cursor="Hand"/>
                <Button Content="500,000" Command="{Binding SetQuickAmountCommand}" CommandParameter="500000"
                        Margin="0,0,5,5" Width="75" Height="30" Background="#f3f4f6" BorderThickness="0" Cursor="Hand"/>
            </WrapPanel>

            <Separator Margin="0,15"/>

            <!-- Tiền thối lại -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tiền thối lại:" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                <TextBlock Grid.Column="1" Text="{Binding TienThoi, Converter={StaticResource CurrencyConverter}}" 
                           FontSize="18" FontWeight="Bold" Foreground="#059669"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
