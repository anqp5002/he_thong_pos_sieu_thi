<UserControl x:Class="HeThongPOS.WPF.Controls.CartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ListView Grid.Row="0" ItemsSource="{Binding CartItems}" Margin="0,0,0,10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5" Width="300">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SanPham.TenSanPham}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SoLuong, StringFormat=SL: {0}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ThanhTien, StringFormat={}{0:N0} đ}" Foreground="#e53935" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                        <Button Grid.Column="3" Content="X" Background="#ff4444" Foreground="White" Width="20" Height="20" 
                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="1" Background="#f5f5f5" Padding="15" CornerRadius="8">
            <StackPanel>
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="Cộng tiền hàng:" Foreground="#757575"/>
                    <TextBlock Text="{Binding TongTienHang, StringFormat={}{0:N0} đ}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Thuế VAT:" Foreground="#757575"/>
                    <TextBlock Text="{Binding ThueVAT, StringFormat={}{0:N0} đ}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="TỔNG CỘNG:" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TongThanhToan, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="#e53935" HorizontalAlignment="Right"/>
                </Grid>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Hủy đơn" Command="{Binding ClearCartCommand}" Margin="0,0,5,0" Background="#eeeeee"/>
                    <Button Grid.Column="1" Content="THANH TOÁN" Command="{Binding CheckoutCommand}" Margin="5,0,0,0" Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
