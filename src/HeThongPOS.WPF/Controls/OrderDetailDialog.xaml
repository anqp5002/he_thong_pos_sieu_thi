<Window x:Class="HeThongPOS.WPF.Controls.OrderDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết Đơn hàng" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Order Info -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã đơn:" FontWeight="Bold" Margin="0,0,10,5"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Order.MaDonHang}"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Ngày tạo:" FontWeight="Bold" Margin="0,0,10,5"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Order.NgayTao, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Khách hàng:" FontWeight="Bold" Margin="0,0,10,5"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Order.KhachHang.HoTen}"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Nhân viên:" FontWeight="Bold" Margin="0,0,10,5"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Order.NhanVien.HoTen}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Trạng thái:" FontWeight="Bold" Margin="0,0,10,5"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Order.TrangThai}"/>
        </Grid>

        <!-- Items DataGrid -->
        <TextBlock Grid.Row="1" Text="Danh sách sản phẩm:" FontWeight="Bold" Margin="0,0,0,5"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding OrderItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sản Phẩm" Binding="{Binding SanPham.TenSanPham}" Width="*"/>
                <DataGridTextColumn Header="Số Lượng" Binding="{Binding SoLuong}" Width="80"/>
                <DataGridTextColumn Header="Đơn Giá" Binding="{Binding DonGia, StringFormat={}{0:N0} ₫}" Width="120"/>
                <DataGridTextColumn Header="Thành Tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0} ₫}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Total Info -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5" HorizontalAlignment="Right">
                <TextBlock Text="Tiền hàng:" Width="100" TextAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Order.TongTienHang, StringFormat={}{0:N0} ₫}" Width="120" TextAlignment="Right"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5" HorizontalAlignment="Right">
                <TextBlock Text="Chiết khấu:" Width="100" TextAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Order.ChietKhau, StringFormat={}{0:N0} ₫}" Width="120" TextAlignment="Right"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5" HorizontalAlignment="Right">
                <TextBlock Text="Thuế VAT:" Width="100" TextAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Order.ThueVAT, StringFormat={}{0:N0} ₫}" Width="120" TextAlignment="Right"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" HorizontalAlignment="Right">
                <TextBlock Text="Tổng thanh toán:" FontWeight="Bold" Width="100" TextAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Order.TongThanhToan, StringFormat={}{0:N0} ₫}" FontWeight="Bold" Width="120" TextAlignment="Right" Foreground="#007ACC"/>
            </StackPanel>

            <Button Content="Đóng" Width="80" HorizontalAlignment="Right" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
