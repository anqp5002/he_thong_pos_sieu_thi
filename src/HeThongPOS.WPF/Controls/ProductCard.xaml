<UserControl x:Class="HeThongPOS.WPF.Controls.ProductCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
        <Border Background="White" BorderBrush="#ddd" BorderThickness="1" CornerRadius="8" Padding="10" Margin="5" Width="140" Height="120">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding TenSanPham}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="{Binding GiaBan, StringFormat={}{0:N0} đ}" Foreground="#e53935" FontWeight="SemiBold" TextAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Text="{Binding TonKho, StringFormat=Tồn: {0}}" Foreground="#757575" FontSize="11" TextAlignment="Center"/>
            </Grid>
        </Border>
    </Button>
</UserControl>
