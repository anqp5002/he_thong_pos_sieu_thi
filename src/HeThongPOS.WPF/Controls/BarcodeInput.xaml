<UserControl x:Class="HeThongPOS.WPF.Controls.BarcodeInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalContentAlignment="Center" FontSize="14" Padding="5" Margin="0,0,10,0" ToolTip="Quét mã vạch vào đây"/>
        <Button Grid.Column="1" Content="Quét" Command="{Binding ProcessBarcodeCommand}" Width="80" Style="{StaticResource PrimaryButton}"/>
    </Grid>
</UserControl>
