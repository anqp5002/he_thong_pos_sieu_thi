<Window x:Class="HeThongPOS.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HeThongPOS.WPF.Views"
        Title="Hệ Thống POS Siêu Thị" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource MainBackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBackgroundColor}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryColor}" CornerRadius="8" Width="40" Height="40" Margin="0,0,10,0">
                        <TextBlock Text="🛒" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RetailPOS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="POINT OF SALE" FontSize="10" Foreground="{StaticResource TextSecondaryColor}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="📦 Đơn hàng" Style="{StaticResource OutlinedButton}" Margin="0,0,10,0" Click="NavOrders_Click" x:Name="BtnOrders"/>
                    <Button Content="👥 Khách hàng" Style="{StaticResource OutlinedButton}" Margin="0,0,10,0" Click="NavCustomers_Click" x:Name="BtnCustomers"/>
                </StackPanel>

                <!-- User Profile & Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,15,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Screen ID" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" TextAlignment="Right"/>
                        <TextBlock Text="S-ADMIN-001" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryColor}" TextAlignment="Right"/>
                    </StackPanel>
                    
                    <!-- Avatar -->
                    <Border Background="{StaticResource PrimaryColor}" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0">
                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nguyễn Văn A" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="Nhân viên" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <ContentControl x:Name="MainContent" Grid.Row="1" Margin="20"/>
    </Grid>
</Window>
