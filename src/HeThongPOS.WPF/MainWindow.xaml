<Window x:Class="HeThongPOS.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ Thống POS Siêu Thị" Height="768" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Style cho nút Sidebar -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút Sidebar đang active -->
        <Style x:Key="SidebarButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#1d4ed8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#1d4ed8" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- ============ SIDEBAR (Ẩn khi chưa đăng nhập) ============ -->
        <Grid x:Name="LayoutWithSidebar" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Border Grid.Column="0" Background="#111827">
                <DockPanel>
                    <!-- Logo Section -->
                    <Border DockPanel.Dock="Top" Padding="20,24,20,20">
                        <StackPanel>
                            <TextBlock Text="🛒 POS System" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Siêu Thị Desktop" FontSize="12" Foreground="#6b7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Border DockPanel.Dock="Top" Height="1" Background="#374151" Margin="16,0"/>

                    <!-- User Info Section (Bottom) -->
                    <Border DockPanel.Dock="Bottom" Padding="16,12" Background="#1f2937">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#3b82f6">
                                <TextBlock x:Name="UserInitialsText" Text="?" 
                                           Foreground="White" FontWeight="Bold" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Name & Role -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" Text="Chưa đăng nhập" 
                                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UserRoleText" Text="" 
                                           Foreground="#9ca3af" FontSize="11"/>
                            </StackPanel>
                            <!-- Logout -->
                            <Button Grid.Column="2" Content="⬅" FontSize="18" ToolTip="Đăng xuất"
                                    Style="{StaticResource SidebarButton}" Padding="8"
                                    Click="Logout_Click"/>
                        </Grid>
                    </Border>

                    <!-- Divider trước user info -->
                    <Border DockPanel.Dock="Bottom" Height="1" Background="#374151" Margin="16,0"/>

                    <!-- ===== MENU ITEMS ===== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
                        <StackPanel>
                            <!-- Label -->
                            <TextBlock Text="MENU CHÍNH" FontSize="10" FontWeight="Bold" 
                                       Foreground="#6b7280" Margin="24,8,0,8"/>

                            <Button x:Name="BtnPOS" Content="🏪  Bán Hàng (POS)" 
                                    Style="{StaticResource SidebarButton}" Click="NavToPOS_Click"/>

                            <Button x:Name="BtnShift" Content="⏰  Ca Làm Việc" 
                                    Style="{StaticResource SidebarButton}" Click="NavToShift_Click"/>

                            <!-- Label Admin -->
                            <TextBlock x:Name="LabelQuanLy" Text="QUẢN LÝ" FontSize="10" FontWeight="Bold" 
                                       Foreground="#6b7280" Margin="24,20,0,8"
                                       Visibility="Collapsed"/>

                            <Button x:Name="BtnProducts" Content="📦  Sản Phẩm" 
                                    Style="{StaticResource SidebarButton}" Click="NavToProducts_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="BtnCustomers" Content="👥  Khách Hàng" 
                                    Style="{StaticResource SidebarButton}" Click="NavToCustomers_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="BtnDashboard" Content="📊  Thống Kê / Báo cáo" 
                                    Style="{StaticResource SidebarButton}" Click="NavToDashboard_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== MAIN CONTENT AREA ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#e5e7eb" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <TextBlock x:Name="PageTitle" Text="Bán Hàng" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#111827" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderUserName" Text="" Foreground="#6b7280" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#dbeafe">
                                <TextBlock x:Name="HeaderUserInitials" Text="?" Foreground="#1d4ed8" 
                                           FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stock Alert Bar (Mục 7) -->
                <Border x:Name="StockAlertBar" Grid.Row="1" Background="#fef3c7" 
                        BorderBrush="#f59e0b" BorderThickness="0,0,0,1"
                        Padding="16,10" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StockAlertText" Text="" Foreground="#92400e" 
                                       FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent"
                                BorderThickness="0" Foreground="#92400e" FontSize="14" Cursor="Hand"
                                Click="CloseStockAlert_Click"/>
                    </Grid>
                </Border>

                <!-- Page Content Frame -->
                <Border Grid.Row="2" Background="#f3f4f6">
                    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ LOGIN FRAME (Hiển thị khi chưa đăng nhập) ============ -->
        <Frame x:Name="LoginFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
