# === SQL Server Docker ===
SA_PASSWORD=YourStrong@Passw0rd
ACCEPT_EULA=Y

# === Connection String (.NET) ===
# Dùng trong appsettings.Development.json hoặc User Secrets
CONNECTION_STRING=Server=localhost,1433;Database=HeThongPOS;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=true;

# === PayOS Configuration ===
# Dùng cho tính năng thanh toán tự động (Cấu hình trong tài khoản PayOS)
PAYOS_CLIENT_ID=YOUR_CLIENT_ID
PAYOS_API_KEY=YOUR_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_CHECKSUM_KEY